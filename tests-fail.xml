<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." default="fail" name="ant-javacard failing tests">
    <import file="kits.xml"/>
    <import file="tests-imports.xml"/>

    <target name="fail" depends="jcpro,fail-sdks"/>

    <!-- A conversion error from the forked converter -->
    <target name="fail-sdks">
        <javacard>
            <!-- JC 3.2.0 -->
            <cap jckit="${SDK25.0}" sources="src/testapplets/fail" ints="false">
                <applet class="testapplets.fail.Fail" aid="0102030405060708"/>
            </cap>
        </javacard>
    </target>

    <!-- A conversion error from the in-process converter of v26.0 -->
    <target name="fail-inprocess" depends="jcpro">
        <javacard>
            <cap jckit="${SDK26.0}" sources="src/testapplets/fail" ints="false">
                <applet class="testapplets.fail.Fail" aid="0102030405060708"/>
            </cap>
        </javacard>
    </target>

    <!-- Two folders offering testapplets.library in versions 1.0 and 2.0 -->
    <target name="fail-imports-collision" depends="test-imports-library">
        <javacard>
            <cap jckit="${SDK26.0}" sources="src/testapplets/libraryuser" aid="0102030405" output="testimports/user-collision.cap">
                <applet class="testapplets.libraryuser.LibraryUser" aid="0102030405060708"/>
                <import exps="testimports/exps" jar="testimports/library.jar"/>
                <import exps="testimports/exps2"/>
            </cap>
        </javacard>
    </target>
