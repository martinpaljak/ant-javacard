<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." default="test" name="ant-javacard tests">
    <import file="kits.xml"/>
    <import file="tests-imports.xml"/>
    <!-- Build test applets -->
    <target name="test" depends="jcpro,test-library-user,test-multiapp,test-no-output,test-sdks,test-stringdef,test-targetsdk,test-oldcross,test-exp-version,test-imports,test-targets"/>
    <!-- Cross-verify matrix: one smoke test per SDKVersion supported on JDK 8 -->
    <target name="test-sdks">
        <javacard>
            <cap jckit="${SDK2.1.1}" sources="src/testapplets/empty" verify="false">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
            <cap jckit="${SDK2.1.2}" sources="src/testapplets/empty" verify="false">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
            <cap jckit="${SDK2.2.1}" sources="src/testapplets/empty">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
            <cap jckit="${SDK2.2.2}" sources="src/testapplets/empty">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
            <cap jckit="${SDK3.0.3}" sources="src/testapplets/empty">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
            <cap jckit="${SDK3.0.4}" sources="src/testapplets/empty">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
            <cap jckit="${SDK3.0.5u4}" sources="src/testapplets/empty">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
            <cap jckit="${SDK3.1.0}" sources="src/testapplets/empty">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
            <cap jckit="${SDK24.0}" sources="src/testapplets/empty">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
            <!-- Skipped: v24.1 tools need JDK 11 or later -->
            <cap jckit="${SDK25.0}" sources="src/testapplets/empty">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
            <cap jckit="${SDK25.1}" sources="src/testapplets/empty">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
            <cap jckit="${SDK26.0}" sources="src/testapplets/empty">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
            <cap jckit="${SDK3.0.4}" sources="src/testapplets/integer" ints="true">
                <applet class="testapplets.integer.EmptyInt" aid="0102030405060708"/>
            </cap>
        </javacard>
    </target>
    <!-- Output file generation -->
    <target name="test-no-output" depends="jcpro">
        <javacard jckit="${SDK3.0.4}">
            <cap sources="src/testapplets/empty">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
        </javacard>
    </target>
    <!-- Library -->
    <target name="test-library-old" depends="jcpro">
        <javacard jckit="${SDK3.0.5u4}">
            <cap targetsdk="${SDK2.2.2}" sources="src/testapplets/library" package="testapplets.library" aid="01020304050607" export="testlib" version="127.0"/>
        </javacard>
    </target>
    <!-- Library -->
    <target name="test-library" depends="jcpro,test-library-old">
        <javacard jckit="${SDK3.1.0}">
            <cap targetsdk="3.0.4" sources="src/testapplets/library" package="testapplets.library" aid="01020304050607" export="testlib" version="127.0"/>
        </javacard>
    </target>
    <!-- JC 2.2.2 with 3.0.4 library -->
    <target name="test-library-user" depends="jcpro,test-library">
        <javacard>
            <cap jckit="${SDK2.2.2}" sources="src/testapplets/libraryuser">
                <applet class="testapplets.libraryuser.LibraryUser" aid="0102030405060708"/>
                <import jar="testlib/library.jar"/>
            </cap>
            <!-- The v3.0.x converters generate proxy classes for the shareable interface unless told not to -->
            <cap jckit="${SDK3.0.5u4}" sources="src/testapplets/libraryuser">
                <applet class="testapplets.libraryuser.LibraryUser" aid="0102030405060708"/>
                <import jar="testlib/library.jar"/>
            </cap>
        </javacard>
    </target>
    <!-- JC 3.0.4 multiapp -->
    <target name="test-multiapp" depends="jcpro">
        <javacard>
            <cap jckit="${SDK3.0.3}" output="Multiapp.cap" sources="src/testapplets/multiapp" aid="010203040506">
                <applet class="testapplets.multiapp.First" aid="01020304050607"/>
                <applet class="testapplets.multiapp.Second" aid="0102030405060708"/>
                <import jar="testlib/library.jar"/>
            </cap>
        </javacard>
    </target>
    <!-- Stringdefs -->
    <target name="test-stringdef" depends="jcpro">
        <javacard>
            <cap jckit="${SDK3.0.4}" output="StringDefs.cap" sources="src/testapplets/stringdefs" aid="010203040506">
                <applet class="testapplets.stringdefs.Empty"/>
            </cap>
        </javacard>
    </target>
    <!-- targetsdk -->
    <target name="test-targetsdk" depends="jcpro">
        <javacard>
            <cap jckit="${SDK3.0.5u4}" targetsdk="${SDK2.2.1}" sources="src/testapplets/empty" aid="010203040506">
                <applet class="testapplets.empty.Empty"/>
            </cap>
        </javacard>
    </target>
    <!-- Cross-compile against old SDK -->
    <target name="test-oldcross" depends="jcpro">
        <javacard jckit="${SDK3.0.5u4}">
            <!-- Verification is supported for 2.2.1 and upwards-->
            <cap targetsdk="${SDK2.1.1}" sources="src/testapplets/empty" verify="false">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
        </javacard>
    </target>
    <target name="test-exp-version" depends="jcpro">
        <javacard jckit="${SDK3.1.0}">
            <cap targetsdk="3.1.0" sources="src/testapplets/empty" verify="true">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
            <cap targetsdk="3.0.5" sources="src/testapplets/empty" verify="true">
