<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." default="test" name="ant-javacard tests">
    <import file="kits.xml"/>
    <import file="tests-imports.xml"/>

    <!-- Build test applets -->
    <target name="test" depends="jcpro,test-sdks,test-nested-sources,test-imports,test-targets"/>

    <!-- Cross-verify matrix: one smoke test per SDKVersion supported on JDK 21 -->
    <target name="test-sdks">
        <javacard>
            <!-- Skipped: v2.1.1 to v24.1 converters take class files up to 1.7 and JDK 21 writes 1.8 at minimum -->
            <cap jckit="${SDK25.0}" sources="src/testapplets/empty">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
            <cap jckit="${SDK25.1}" sources="src/testapplets/empty">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
            <cap jckit="${SDK26.0}" sources="src/testapplets/empty">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
        </javacard>
    </target>
    <!-- Nested sources with per-path includes/excludes -->
    <target name="test-nested-sources" depends="jcpro">
        <javacard>
            <cap jckit="${SDK26.0}" aid="010203040506">
                <applet class="testapplets.empty.Empty"/>
                <sources path="src/testapplets/empty"/>
            </cap>
        </javacard>
    </target>
    <!-- Named targetsdk versions of the multi-target SDKs -->
    <target name="test-targets" depends="jcpro">
        <javacard jckit="${SDK25.0}">
            <cap targetsdk="3.0.4" sources="src/testapplets/empty">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
            <cap targetsdk="3.0.5" sources="src/testapplets/empty">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
            <cap targetsdk="3.1.0" sources="src/testapplets/empty">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
            <cap targetsdk="3.2.0" sources="src/testapplets/empty">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
        </javacard>
        <javacard jckit="${SDK25.1}">
            <cap targetsdk="3.0.4" sources="src/testapplets/empty">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
            <cap targetsdk="3.0.5" sources="src/testapplets/empty">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
            <cap targetsdk="3.1.0" sources="src/testapplets/empty">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
            <cap targetsdk="3.2.0" sources="src/testapplets/empty">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
        </javacard>
        <javacard jckit="${SDK26.0}">
            <cap targetsdk="3.0.4" sources="src/testapplets/empty">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
            <cap targetsdk="3.0.5" sources="src/testapplets/empty">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
            <cap targetsdk="3.1.0" sources="src/testapplets/empty">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
            <cap targetsdk="3.2.0" sources="src/testapplets/empty">
                <applet class="testapplets.empty.Empty" aid="0102030405060708"/>
            </cap>
        </javacard>
    </target>
</project>
